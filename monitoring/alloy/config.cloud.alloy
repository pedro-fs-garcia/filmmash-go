// Production config: ships logs and metrics to Grafana Cloud.
// Mounted over config.alloy by docker-compose.prod.yaml; credentials come
// from GRAFANA_CLOUD_* env vars (see .env.example).

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.process.pipeline.receiver]
}

loki.process "pipeline" {
	forward_to = [loki.write.grafana_cloud.receiver]

	// Only parse JSON for the app; Postgres and plaintext lines are left untouched.
	stage.match {
		selector = "{service=\"app\"}"

		stage.json {
			expressions = {
				level      = "level",
				method     = "method",
				msg        = "msg",
				time       = "time",
				request_id = "request_id",
				duel_id    = "duel_id",
			}
		}

		// Low-cardinality fields only -> labels.
		stage.labels {
			values = {
				level  = "",
				method = "",
			}
		}

		// High-cardinality identifiers -> structured metadata (queryable, no new streams).
		stage.structured_metadata {
			values = {
				request_id = "",
				duel_id    = "",
			}
		}

		// Use the application's own timestamp rather than ingest time.
		stage.timestamp {
			source = "time"
			format = "RFC3339Nano"
		}
	}
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}
}

// Replaces the local Prometheus scrape of the app (job="app" preserved so
// dashboard queries keep working).
prometheus.scrape "app" {
	targets    = [{__address__ = "app:8080"}]
	job_name   = "app"
	forward_to = [prometheus.remote_write.grafana_cloud.receiver]

	// 60s, not the 5s used locally: Grafana Cloud's free tier bills a series
	// scraped every 5s as ~12 billable series.
	scrape_interval = "60s"
}

prometheus.remote_write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROM_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROM_USER")
			password = sys.env("GRAFANA_CLOUD_API_KEY")
		}
	}
}
