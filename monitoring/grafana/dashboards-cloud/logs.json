        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "id": 2,
      "options": {
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "pluginVersion": "11.0.0",
      "title": "Request volume by status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "expr": "sum by (status) (count_over_time({service=\"app\"} | json | msg=`http response` [$__auto]))",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      }
    },
    {
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "gridPos": { "h": 20, "w": 24, "x": 0, "y": 6 },
      "id": 1,
      "title": "Application logs",
      "type": "logs",
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
          "expr": "{service=\"app\"} |~ \"(?i)$search\" | json | level=~\"$level\" | line_format \"{{ if .package }}{{ .package }}{{ if .component }}.{{ .component }}{{ end }}{{ if .method }}.{{ .method }}{{ end }}{{ else }}{{ .source_function }}{{ end }} | {{ .msg }}{{ if .path }} path={{ .path }}{{ end }}{{ if .status }} status={{ .status }}{{ end }}{{ if .duration }} dur={{ .duration }}{{ end }}{{ if .duel_id }} duel={{ .duel_id }}{{ end }}{{ if .error }} error={{ .error }}{{ end }}{{ if .request_id }} req={{ .request_id }}{{ end }}\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["filmmash", "logs"],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
        "query": { "label": "level", "stream": "{service=\"app\"}", "type": 1 },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Filmmash Logs",
  "uid": "filmmash-logs",
  "version": 1,
  "weekStart": ""
}
