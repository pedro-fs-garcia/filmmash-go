GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/filmmash_db?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

APP_BASE_URL=http://localhost

# Locally this stays "localhost" (Caddy serves HTTPS with
# its own local CA, no external calls). In production, set this to your real
# domain (e.g. filmmash.example.com)
DOMAIN=filmmash.example.com

# Base64-encoded 32-byte key for encrypting the OIDC flow cookie (generate with `openssl rand -base64 32`).
# If unset, an ephemeral key is generated at startup: logins in progress won't survive restarts or multiple replicas.
AES_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=filmmash_db
POSTGRES_SSLMODE=disable

TMDB_API_TOKEN=tmdb-api-token-here

ZITADEL_CLIENT_ID=zitadel-client-id
ZITADEL_CLIENT_SECRET=zitadel-client-secret
ZITADEL_BASE_URL=zitadel-app-url
# Service user (machine user) credentials for machine-to-machine API calls
ZITADEL_M2M_CLIENT_ID=zitadel-service-user-login-name
ZITADEL_M2M_CLIENT_SECRET=zitadel-service-user-client-secret

# Duel matchmaking. The opponent pool is the MAXIMUM_CANDIDATES films closest
# in rating; of those, films within DUEL_RATING_WINDOW are kept, padded with
# the next-closest up to MINIMUM_CANDIDATES so top/bottom outliers don't keep
# dueling the same few films.
DUEL_RATING_WINDOW=350
MINIMUM_CANDIDATES=10
MAXIMUM_CANDIDATES=40
# Selection weight by TMDB popularity (0 = uniform random among candidates).
DUEL_POPULARITY_WEIGHT=1.0
# Films with fewer than DUEL_NEW_FILM_THRESHOLD duels get their selection
# weight multiplied by DUEL_NEW_FILM_BOOST (1.0 = off), so new films get rated quickly.
DUEL_NEW_FILM_BOOST=1.0
DUEL_NEW_FILM_THRESHOLD=10

# Email/SMTP provider for Alertmanager (Resend by default; swap host/user/pass for another provider)
SMTP_SMARTHOST=smtp.resend.com:587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_yourresendapikey
ALERT_EMAIL_SENDER=alerts@filmmash.com
ALERT_EMAIL_RECEIVER=email-to-receive@alerts.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Which compose profiles to start by default. "monitoring" runs the local
# grafana/loki/prometheus/alertmanager stack (dev). Leave empty on the VPS.
COMPOSE_PROFILES=monitoring

# Grafana Cloud (production only — used by monitoring/alloy/config.cloud.alloy).
# URLs and numeric user IDs are on your stack's details page (grafana.com -> My Account).
# The API key is an Access Policy token with metrics:write and logs:write scopes.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XXX.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=prometheus-numeric-instance-id
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=loki-numeric-user-id
GRAFANA_CLOUD_API_KEY=glc_your-access-policy-token
