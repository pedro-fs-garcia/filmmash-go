GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/filmmash_db?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=filmmash_db

TMDB_API_TOKEN=tmdb-api-token-here

ZITADEL_CLIENT_ID=zitadel-client-id
ZITADEL_CLIENT_SECRET=zitadel-client-secret
ZITADEL_BASE_URL=zitadel-app-url

# Email/SMTP provider for Alertmanager (Resend by default; swap host/user/pass for another provider)
SMTP_SMARTHOST=smtp.resend.com:587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_yourresendapikey
ALERT_EMAIL_SENDER=alerts@filmmash.com
ALERT_EMAIL_RECEIVER=email-to-receive@alerts.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
